      {
        "props": {
          "title": "Visit Us",
          "style": "h2",
          "align": "left"
        },
        "type": "paragraph",
        "id": "1fef60dd-9390-41b7-a5e7-dfd5db660646"
      },
      {
        "props": {
          "style": "body",
          "align": "left",
          "title": "We hope you and your family will visit us and immerse yourselves in our university and city. Our location, in the geographic center of San Francisco, is a big part of the student experience. Our admission team will take you around our 55-acre Hilltop campus to show you the classrooms, residence halls, and study spots that will be a part of your life as a Don. We offer daily student-guided tours, group visits, a fall open house for prospective students, and special events for admitted students (both first-year and transfer). Schedule a visit today - we know you’ll love it once you get here.\n"
        },
        "type": "paragraph",
        "id": "946d9fe7-dd10-4c14-88c5-c1dae2444b79"
      },
